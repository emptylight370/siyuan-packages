{
  "tabWidth": 2,
  "printWidth": 120,
  "bracketSameLine": true,
  "singleQuote": true,
  "endOfLine": "auto",
  "overrides": [
    {
      "files": ["*.scss", "*.css"],
      "options": {
        "tabWidth": 4
      }
    },
    {
      "files": ["*.ts","*.js", "*.cjs", "*.mjs"],
      "options": {
        "tabWidth": 4
      }
    },
    {
      "files": [".github/workflows/*"],
      "options": {
        "singleQuote": false
      }
    }
  ]
}
