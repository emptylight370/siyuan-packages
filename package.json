{
  "name": "siyuan-packages",
  "version": "0.0.0",
  "private": true,
  "description": "SiYuan plugin monorepo",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "lint": "eslint packages/plugin",
    "lint:fix": "eslint packages/plugin --fix --cache",
    "format": "prettier -w ."
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "typescript": "^6.0.3"
  }
}
