{
  "name": "siyuan-packages",
  "version": "0.0.0",
  "private": true,
  "description": "SiYuan plugin monorepo",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "lint": "oxlint packages",
    "lint:fix": "oxlint packages --fix",
    "format": "prettier -w ."
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0"
    }
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.6.6",
    "oxlint": "^1.93.0",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2"
  }
}
